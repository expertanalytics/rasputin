+// Serial simulations of the parallel schedules of 21-parallel-refine.md
+// section 5, selected by the environment variable RASPUTIN_SIM:
+//   today   -- today's loop (index order, skip rule), optionally recording
+//              per-insertion footprints (RASPUTIN_SIM_FOOT=1) for the
+//              dependence depth and footprint extents (section 6, Q2, Q6a);
+//   C       -- option C: batch insert (split sets disjoint by lower slot
+//              index), then flip rounds of a locally-minimal-key independent
+//              edge set (Qi, Cao and Tan);
+//   Cthin   -- C, and a mark is deferred when an edge-adjacent triangle is
+//              marked with a lower slot index (section 5's thinning rule);
+//   Cmis    -- C, and a mark inserts only if no edge-adjacent mark with a
+//              lower slot index inserts (greedy MIS in index order);
+//   A1      -- option A1: deterministic reservations, priority a hash of the
+//              worst node (row, col) then slot, footprint = Bowyer-Watson
+//              cavity plus its ring, skip rule kept.
+// Every mode writes one JSON object to RASPUTIN_SIM_OUT.
+//
+// Each parallel step is simulated serially; the argument that the serial
+// execution equals the parallel one is in the README ("Why the serial
+// simulation is the parallel result").
+
+#include <terrain/mesh/lattice_mesh.hpp>
+#include <terrain/mesh/lawson.hpp>
+#include <terrain/predicates/default_kernel.hpp>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace terrain::refinement::sim {
+
+inline std::string mode() {
+    const char* s = std::getenv("RASPUTIN_SIM");
+    return s ? std::string{s} : std::string{};
+}
+
+// Planted defects, to show each check can fail (README, "The checks can fail").
+inline bool plant(const char* what) {
+    const char* s = std::getenv("RASPUTIN_SIM_PLANT");
+    return s && std::string{s} == what;
+}
+
+inline std::uint64_t seed() {
+    const char* s = std::getenv("RASPUTIN_SIM_SEED");
+    return s ? std::strtoull(s, nullptr, 10) : 0;
+}
+
+inline std::uint64_t splitmix(std::uint64_t x) {
+    x += 0x9e3779b97f4a7c15ULL;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    return x ^ (x >> 31);
+}
+
+// Strictly inside n's circumcircle, in the frame. Answers true (the
+// conservative side: a bigger footprint) on a frame-orientation corner case.
+inline bool in_circle(const mesh::LatticeMesh& m, std::uint32_t n, mesh::MeshVertex p,
+                      const mesh::LatticeFrame& f) {
+    const auto& tri = m.triangles()[n];
+    const auto v = m.vertices();
+    if (const auto s = mesh::lattice_incircle(v[tri[0]], v[tri[1]], v[tri[2]], p, f))
+        return *s == pred::Incircle::Inside;
+    const Point2 a = f.at(v[tri[0]]), b = f.at(v[tri[1]]), c = f.at(v[tri[2]]), d = f.at(p);
+    if (pred::DefaultKernel::orient2d(a, b, c) == pred::Orientation::CounterClockwise)
+        return pred::DefaultKernel::incircle(a, b, c, d) == pred::Incircle::Inside;
+    return true;
+}
+
+// Per-round record, shared by all modes; fields a mode does not use stay 0.
+struct Round {
+    std::size_t active = 0, marked = 0, inserted = 0, skipped_touched = 0, skipped_edge = 0,
+                deferred_conflict = 0, deferred_thin = 0, flips = 0, flip_rounds = 0,
+                flip_candidates_first = 0, flips_first = 0, subrounds = 0, winners_first = 0,
+                cavity_violations = 0, fp_sum = 0, fp_max = 0, depth = 0;
+    // today+FOOT: footprint bbox larger side quantiles, and halo / boundary counts
+    std::vector<std::uint32_t> side;          // per insertion
+    std::map<int, std::size_t> leaves_halo;   // B -> insertions whose bbox leaves the B/2 halo
+    std::map<int, std::size_t> crosses;       // B -> insertions whose bbox crosses a block boundary
+    std::map<int, std::pair<std::size_t, double>> per_block;  // B -> (max, mean over hit blocks)
+    std::vector<std::uint32_t> subround_winners;  // A1
+};
+
+inline std::uint32_t quant(std::vector<std::uint32_t> v, double q) {
+    if (v.empty())
+        return 0;
+    std::sort(v.begin(), v.end());
+    return v[std::min(v.size() - 1, static_cast<std::size_t>(q * static_cast<double>(v.size())))];
+}
+
+inline void write_json(const std::string& md, const std::vector<Round>& rs, std::size_t triangles,
+                       std::size_t inserted, std::size_t flips, double full_max, std::size_t over,
+                       std::size_t full_scanned, std::vector<std::uint32_t> all_sides,
+                       std::vector<std::uint32_t> fp_all) {
+    const char* path = std::getenv("RASPUTIN_SIM_OUT");
+    if (!path)
+        return;
+    FILE* o = std::fopen(path, "w");
+    if (!o)
+        return;
+    std::fprintf(o, "{\"mode\":\"%s\",\"triangles\":%zu,\"inserted\":%zu,\"flips\":%zu,"
+                    "\"full_rescan_max_error\":%.9g,\"full_rescan_needs_split\":%zu,"
+                    "\"full_rescan_triangles\":%zu,",
+                 md.c_str(), triangles, inserted, flips, full_max, over, full_scanned);
+    std::fprintf(o, "\"fp_p50\":%u,\"fp_p90\":%u,\"fp_p99\":%u,\"fp_max\":%u,",
+                 quant(fp_all, 0.5), quant(fp_all, 0.9), quant(fp_all, 0.99),
+                 fp_all.empty() ? 0u : *std::max_element(fp_all.begin(), fp_all.end()));
+    std::fprintf(o, "\"side_p50\":%u,\"side_p90\":%u,\"side_p99\":%u,\"side_max\":%u,",
+                 quant(all_sides, 0.5), quant(all_sides, 0.9), quant(all_sides, 0.99),
+                 all_sides.empty() ? 0u : *std::max_element(all_sides.begin(), all_sides.end()));
+    std::fprintf(o, "\"rounds\":[");
+    for (std::size_t i = 0; i < rs.size(); ++i) {
+        const Round& r = rs[i];
+        std::fprintf(o, "%s{\"round\":%zu,\"active\":%zu,\"marked\":%zu,\"inserted\":%zu,"
+                        "\"skipped_touched\":%zu,\"skipped_edge\":%zu,\"deferred_conflict\":%zu,"
+                        "\"deferred_thin\":%zu,\"flips\":%zu,\"flip_rounds\":%zu,"
+                        "\"flip_candidates_first\":%zu,\"flips_first\":%zu,\"subrounds\":%zu,"
+                        "\"winners_first\":%zu,\"cavity_violations\":%zu,\"fp_sum\":%zu,"
+                        "\"fp_max\":%zu,\"depth\":%zu",
+                     i ? "," : "", i + 1, r.active, r.marked, r.inserted, r.skipped_touched,
+                     r.skipped_edge, r.deferred_conflict, r.deferred_thin, r.flips, r.flip_rounds,
+                     r.flip_candidates_first, r.flips_first, r.subrounds, r.winners_first,
+                     r.cavity_violations, r.fp_sum, r.fp_max, r.depth);
+        if (!r.side.empty())
+            std::fprintf(o, ",\"side_p50\":%u,\"side_p90\":%u,\"side_p99\":%u,\"side_max\":%u",
+                         quant(r.side, 0.5), quant(r.side, 0.9), quant(r.side, 0.99),
+                         *std::max_element(r.side.begin(), r.side.end()));
+        for (const auto& [b, n] : r.leaves_halo)
+            std::fprintf(o, ",\"leaves_halo_%d\":%zu", b, n);
+        for (const auto& [b, n] : r.crosses)
+            std::fprintf(o, ",\"crosses_%d\":%zu", b, n);
+        for (const auto& [b, mm] : r.per_block)
+            std::fprintf(o, ",\"block_max_%d\":%zu,\"block_mean_%d\":%.3f", b, mm.first, b, mm.second);
+        if (!r.subround_winners.empty()) {
+            std::fprintf(o, ",\"subround_winners\":[");
+            for (std::size_t k = 0; k < r.subround_winners.size(); ++k)
+                std::fprintf(o, "%s%u", k ? "," : "", r.subround_winners[k]);
+            std::fprintf(o, "]");
+        }
+        std::fprintf(o, "}");
+    }
+    std::fprintf(o, "]}\n");
+    std::fclose(o);
+}
+
+// Footprint of one committed insertion, from what it wrote: W (every slot
+// written, appended ones included) plus every edge neighbour of W afterwards,
+// which is the ring (read across the tested edge, and repointed).
+inline std::vector<std::uint32_t> footprint_after(const mesh::LatticeMesh& m,
+                                                  std::vector<std::uint32_t> w) {
+    std::sort(w.begin(), w.end());
+    w.erase(std::unique(w.begin(), w.end()), w.end());
+    std::vector<std::uint32_t> fp = w;
+    for (const auto s : w)
+        for (const auto n : m.neighbours(s))
+            if (n != mesh::kNoNeighbour)
+                fp.push_back(n);
+    std::sort(fp.begin(), fp.end());
+    fp.erase(std::unique(fp.begin(), fp.end()), fp.end());
+    return fp;
+}
+
+// Extent records for one insertion at p with footprint fp (today + FOOT).
+inline void record_extent(Round& rr, const mesh::LatticeMesh& m, const std::vector<std::uint32_t>& fp,
+                          mesh::MeshVertex p, std::vector<std::map<std::pair<long, long>, std::size_t>>& blocks,
+                          const std::vector<int>& bs) {
+    double c0 = p.col, c1 = p.col, r0 = p.row, r1 = p.row;
+    for (const auto s : fp)
+        for (const auto vi : m.triangles()[s]) {
+            const auto v = m.vertices()[vi];
+            c0 = std::min(c0, v.col); c1 = std::max(c1, v.col);
+            r0 = std::min(r0, v.row); r1 = std::max(r1, v.row);
+        }
+    rr.side.push_back(static_cast<std::uint32_t>(std::ceil(std::max(c1 - c0, r1 - r0))));
+    for (std::size_t k = 0; k < bs.size(); ++k) {
+        const int b = bs[k];
+        const long bc = static_cast<long>(std::floor(p.col / b)), br = static_cast<long>(std::floor(p.row / b));
+        const double lo_c = static_cast<double>(bc * b), hi_c = static_cast<double>((bc + 1) * b);
+        const double lo_r = static_cast<double>(br * b), hi_r = static_cast<double>((br + 1) * b);
+        // A box on a block's closed boundary line touches both sides: counted as crossing.
+        if (c0 < lo_c || c1 > hi_c || r0 < lo_r || r1 > hi_r || c0 == lo_c || r0 == lo_r
+            || c1 == hi_c || r1 == hi_r)
+            ++rr.crosses[b];
+        const double h = b / 2.0;
+        if (b <= 128 && (c0 < lo_c - h || c1 > hi_c + h || r0 < lo_r - h || r1 > hi_r + h))
+            ++rr.leaves_halo[b];
+        ++blocks[k][{bc, br}];
+    }
+}
+
+inline void close_blocks(Round& rr, std::vector<std::map<std::pair<long, long>, std::size_t>>& blocks,
+                         const std::vector<int>& bs) {
+    for (std::size_t k = 0; k < bs.size(); ++k) {
+        std::size_t mx = 0, sum = 0;
+        for (const auto& [key, n] : blocks[k]) {
+            mx = std::max(mx, n);
+            sum += n;
+        }
+        rr.per_block[bs[k]] = {mx, blocks[k].empty() ? 0.0 : static_cast<double>(sum) / static_cast<double>(blocks[k].size())};
+        blocks[k].clear();
+    }
+}
+
+}  // namespace terrain::refinement::sim
