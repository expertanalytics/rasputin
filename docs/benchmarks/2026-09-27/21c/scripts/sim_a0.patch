+    // SCRATCH (21c sim.patch, A0): renumber the slots >= n0 and vertices >= v0
+    // by smap[s - n0] and vmap[v - v0], both permutations of their range.
+    void sim_renumber(std::uint32_t n0, std::uint32_t v0, const std::vector<std::uint32_t>& smap,
+                      const std::vector<std::uint32_t>& vmap) {
+        const auto ms = [&](std::uint32_t s) { return s != kNoNeighbour && s >= n0 ? smap[s - n0] : s; };
+        const auto mv = [&](std::uint32_t v) { return v >= v0 ? vmap[v - v0] : v; };
+        auto tri = triangles_;
+        auto nb = neighbours_;
+        auto con = constrained_;
+        auto ma = masks_;
+        auto ve = vertices_;
+        for (std::uint32_t s = 0; s < triangles_.size(); ++s) {
+            const auto d = ms(s);
+            for (unsigned k = 0; k < 3; ++k) {
+                tri[d][k] = mv(triangles_[s][k]);
+                nb[d][k] = ms(neighbours_[s][k]);
+            }
+            con[d] = constrained_[s];
+            ma[d] = masks_[s];
+        }
+        for (std::uint32_t v = v0; v < vertices_.size(); ++v)
+            ve[mv(v)] = vertices_[v];
+        triangles_ = std::move(tri);
+        neighbours_ = std::move(nb);
+        constrained_ = std::move(con);
+        masks_ = std::move(ma);
+        vertices_ = std::move(ve);
+    }
+
