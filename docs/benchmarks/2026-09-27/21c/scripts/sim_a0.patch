+inline std::uint64_t mesh_hash(const mesh::LatticeMesh& m) {
+    std::uint64_t h = 1469598103934665603ULL;
+    const auto mix = [&](std::uint64_t x) { h = (h ^ x) * 1099511628211ULL; };
+    for (const auto& t : m.triangles())
+        for (const auto v : t)
+            mix(v);
+    for (std::size_t t = 0; t < m.triangle_count(); ++t)
+        for (const auto n : m.neighbours(t))
+            mix(n);
+    for (const auto& v : m.vertices()) {
+        std::uint64_t a, b;
+        std::memcpy(&a, &v.col, 8);
+        std::memcpy(&b, &v.row, 8);
+        mix(a);
+        mix(b);
+    }
+    return h;
